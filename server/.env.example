# 桌面服务端配置示例
#
# 用法：复制为 .env 后按需修改（.env 已被 .gitignore 忽略）。
#   server> copy .env.example .env        (PowerShell)
#   server> cp .env.example .env          (bash)
#
# 全部变量都是可选的：不创建 .env 时沿用内置默认值
# （本地存储 server/data/desktop-fs + 令牌 dev-token + 关闭登录）。
# 只有需显式打开某项时，才把对应行取消注释并填值。

# ─────────────── 监听 ───────────────
PORT=8787
# 静态令牌：用于 /dav（WebDAV 客户端 / 外部挂载）与应急入口，建议改成强随机串
DESKTOP_TOKEN=dev-token

# ─────────────── 存储后端 ───────────────
# local（默认，本地目录 + /dav）| object/s3/r2（S3 兼容对象存储）
STORAGE=local
# local 存储根目录（留空 = server/data/desktop-fs）
DESKTOP_FS_ROOT=
# object 模式（AWS S3 / Cloudflare R2 / 阿里云 OSS / 腾讯 COS / MinIO）
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PREFIX=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=

# ─────────────── 代码包公开基址（可选，object 模式用于 widget/plugin 直链）───────────────
PUBLIC_MODE=prefix
PUBLIC_BASE=
PUBLIC_PREFIX=
PUBLIC_BUCKET=

# ─────────────── 网络代理 ───────────────
# =1 时允许代理访问内网地址（默认禁止）
NET_PROXY_ALLOW_PRIVATE=

# ─────────────── 登录 ───────────────
# 设为 1 才开启登录；留空/其它值 = 完全关闭登录（保持旧行为）
AUTH_ENABLED=
# 登录用户名
AUTH_USERNAME=admin
# 密码二选一：明文 AUTH_PASSWORD，或 scrypt 哈希 AUTH_PASSWORD_HASH（推荐）
# 生成哈希（在 server/ 目录下运行）：
#   node --input-type=module -e "import('./src/auth/config.ts').then(m=>console.log(m.hashPassword('你的密码')))"
AUTH_PASSWORD=
AUTH_PASSWORD_HASH=
# 会话签名密钥：务必改成长随机串；不设则用不安全的默认值
SESSION_SECRET=
# 对外访问基址（OAuth 回调、Cookie Secure 判定用），例如 https://desktop.example.com
PUBLIC_BASE_URL=
# 绑定身份文件目录（留空 = server/data/auth）
AUTH_DIR=
# =1 时允许静态令牌也能访问 /api（默认关闭；仅 /dav 使用令牌）
ALLOW_STATIC_FOR_API=

# ─────────────── GitHub 登录 ───────────────
# 回调地址填：<PUBLIC_BASE_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─────────────── 支付宝登录 ───────────────
# 回调地址填：<PUBLIC_BASE_URL>/api/auth/alipay/callback
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 沙箱网关：https://openapi.alipaydev.com/gateway.do
